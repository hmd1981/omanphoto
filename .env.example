# Oman Photo — repo root environment (used by Prisma CLI, scripts/check-env.sh, scripts/prisma-safe.sh).
#
# Local development (Postgres from docker/docker-compose.yml exposed on localhost:5432):
DATABASE_URL="postgresql://omanphoto:omanphoto_dev@localhost:5432/omanphoto?schema=public"
#
# Docker `web` container: compose sets DATABASE_URL to host `db` (never use `db` from your host shell):
#   postgresql://omanphoto:omanphoto_dev@db:5432/omanphoto?schema=public
#
# Bootstrap: if this file is copied to `.env` and you use scripts/prisma-safe.sh, DATABASE_URL loads automatically.
# Create `.env` once (never committed):  cp .env.example .env
#
# Commands (from repo root; Prisma runs with cwd app/, so schema is always ../server/...):
#   bash scripts/check-env.sh
#   bash scripts/prisma-safe.sh migrate deploy --schema=../server/prisma/schema.prisma
#
# From app/ (see package.json): npm run db:migrate:deploy
#
# Admin panel (/admin/login): email admin@omanphoto.com; default password is set via ADMIN_PASSWORD at seed/reset (often `admin` in Docker).
# Password is stored as bcrypt in the database — changing this file alone does not change login until you run reset or re-seed on empty DB.
# - Locked out: cd app && ADMIN_PASSWORD='admin' npm run admin:reset-password
# - Full seed does not change an existing admin password (only name).
