# Copy to repo root as `.env.deploy` and fill in (never commit `.env.deploy`).
#
# Token permissions (Zone):
#   - Cache Purge (Purge)
#   - Zone Settings (Edit) — only if you use CF_ENABLE_DEV_MODE_ON_DEPLOY=1
#
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
#
# Optional: after purge, turn on Development Mode for 3 hours (uncached edge).
# CF_ENABLE_DEV_MODE_ON_DEPLOY=1
#
# Public URL check (required for full deploy unless skipped). Fails deploy if markers missing after CF purge.
# DEPLOY_VERIFY_PUBLIC_URL=https://omanphoto.com/en
# DEPLOY_VERIFY_PUBLIC_RETRIES=10
# DEPLOY_VERIFY_PUBLIC_RETRY_DELAY_SEC=4
# DEPLOY_SKIP_PUBLIC_VERIFY=1   # emergency: skip public HTML assert (origin still checked)
#
# Nginx on same host: optional reload after deploy (requires root or nginx in PATH).
# DEPLOY_NGINX_RELOAD=1
#
# Dev Mode after purge (default 1 when CF token+zone set). Set 0 to only purge.
# CF_ENABLE_DEV_MODE_ON_DEPLOY=0
#
# Deploy log append path
# DEPLOY_LOG_PATH=/var/log/omanphoto-deploy.log
#
# Optional: purge only listed hostnames (set CF_PURGE_HOSTNAMES_ONLY=1).
# CF_PURGE_HOSTNAMES_ONLY=1
# CF_PURGE_HOSTNAMES='["omanphoto.com","www.omanphoto.com"]'
