# Copy to repo root as `.env.deploy` and fill in (never commit `.env.deploy`).
#
# --- GitHub Actions: production SSH deploy (after CI `pipeline` job succeeds) ---
#
# Repository variable (Settings → Secrets and variables → Actions → Variables):
#   PRODUCTION_DEPLOY = true          # enables the deploy-production job
# Optional variables:
#   PUBLIC_VERIFY_URL = https://omanphoto.com   # default if unset
#   PUBLIC_VERIFY_DELAY_SEC = 8        # seconds before public curl (nginx / app restart)
#   PRODUCTION_REPO_PATH = /root/omanphoto      # default if unset
#   PRODUCTION_SSH_PORT = 22           # SSH port (default 22 if unset)
#
# Repository secrets (Settings → Secrets and variables → Actions → Secrets):
#   PRODUCTION_SSH_KEY    # private key (PEM), full file contents including BEGIN/END lines
#   PRODUCTION_SSH_HOST   # hostname or IP of the production server
#   PRODUCTION_SSH_USER   # e.g. root
#
# DATABASE_URL must exist only on the server (docker-compose environment, root `.env`, etc.),
# never in this repo or in GitHub secrets unless you intentionally mirror it for other tooling.
#
# On the server, the deploy user must be able to:
#   cd /root/omanphoto && git pull && ./scripts/zero-downtime-deploy.sh
# (install a deploy key or HTTPS credential for `git` if the repo is private).
#
# --- Blue / green (zero downtime) ---
#
# Slots: web-blue → 127.0.0.1:3001, web-green → 127.0.0.1:3002. Active slot: repo root `.active-slot` (blue|green).
# Previous slot (for rollback): `.previous-slot`. Nginx must include the generated upstream file, e.g.:
#   include /root/omanphoto/docker/nginx-upstream-generated.conf;
# (see docker/nginx.example.conf). First run creates that file from docker/nginx.upstream.active.template.
#
# Deploy: ./scripts/zero-downtime-deploy.sh
# Rollback traffic only: ./scripts/rollback-slot.sh
#
# Full host deploy (build stamps, zero-downtime, Cloudflare, public verify): ./scripts/deploy-production.sh
#
# Optional: DATABASE_URL for deploy-host preflight (scripts/check-env.sh) before `docker compose build`.
# The running `web` container still gets DATABASE_URL from docker-compose.yml (host `db`, not localhost).
# DATABASE_URL=postgresql://omanphoto:omanphoto_dev@127.0.0.1:5432/omanphoto?schema=public
#
# Docker web image (build stamps come ONLY from --build-arg, never from docker/.env):
#   ./docker/build-web.sh
# Do not set NEXT_PUBLIC_BUILD_ID / NEXT_PUBLIC_BUILD_TIME in docker/.env — they are ignored for build
# and would only confuse; use ./docker/build-web.sh or explicit --build-arg.
#
# Token permissions (Zone):
#   - Cache Purge (Purge)
#   - Zone Settings (Edit) — only if you use CF_ENABLE_DEV_MODE_ON_DEPLOY=1
#
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
#
# Optional: after purge, turn on Development Mode for 3 hours (uncached edge).
# CF_ENABLE_DEV_MODE_ON_DEPLOY=1
#
# Public URL check (required for full deploy unless skipped). Fails deploy if markers missing after CF purge.
# DEPLOY_VERIFY_PUBLIC_URL=https://omanphoto.com/en
# DEPLOY_VERIFY_PUBLIC_RETRIES=10
# DEPLOY_VERIFY_PUBLIC_RETRY_DELAY_SEC=4
# DEPLOY_SKIP_PUBLIC_VERIFY=1   # emergency: skip public HTML assert (origin still checked)
#
# Nginx on same host: optional reload after deploy (requires root or nginx in PATH).
# DEPLOY_NGINX_RELOAD=1
#
# Dev Mode after purge (default 1 when CF token+zone set). Set 0 to only purge.
# CF_ENABLE_DEV_MODE_ON_DEPLOY=0
#
# Deploy log append path
# DEPLOY_LOG_PATH=/var/log/omanphoto-deploy.log
#
# Optional: purge only listed hostnames (set CF_PURGE_HOSTNAMES_ONLY=1).
# CF_PURGE_HOSTNAMES_ONLY=1
# CF_PURGE_HOSTNAMES='["omanphoto.com","www.omanphoto.com"]'
